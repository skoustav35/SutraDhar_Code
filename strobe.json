{
  "build": { "command": "bun run build", "cwd": "packages/app", "output": "packages/app/dist" },
  "serve": { "command": "bun e2e/utils/serve.ts --host 127.0.0.1 --port {port}", "cwd": "packages/app" },
  "apps": {
    "sutradhar": {
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.sutradhar.desktop/Sutradhar.exe",
        "macos": "/Applications/Sutradhar.app/Contents/MacOS/Sutradhar"
      },
      "unset": ["SUTRADHAR_*", "OTEL_*", "SENTRY_*"],
      "env": {
        "SUTRADHAR_DB": "{home}/.local/share/sutradhar/sutradhar.db",
        "SUTRADHAR_CONFIG_DIR": "{home}/.config/sutradhar",
        "HTTP_PROXY": "http://127.0.0.1:9",
        "HTTPS_PROXY": "http://127.0.0.1:9",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      },
      "dirs": [".local/share/sutradhar"],
      "files": {
        ".config/sutradhar/service.json": { "port": "{port}" },
        "AppData/Local/@sutradhardesktop-updater": "a file, not a folder: the updater cannot stage a download while strobe measures"
      },
      "guard": [{ "file": "~/.local/state/sutradhar/service.json", "pid": "pid", "url": "url" }],
      "protocols": ["sutradhar"]
    },
    "sutradhar-beta": {
      "extends": "sutradhar",
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.sutradhar.desktop.beta/Sutradhar Beta.exe",
        "macos": "/Applications/Sutradhar Beta.app/Contents/MacOS/Sutradhar Beta"
      }
    }
  }
}
