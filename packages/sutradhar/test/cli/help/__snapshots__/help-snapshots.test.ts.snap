// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`sutradhar CLI help-text snapshots every documented command emits stable help text: sutradhar acp --help 1`] = `
"sutradhar acp

start ACP (Agent Client Protocol) server

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --port         port to listen on                                         [number] [default: 0]
      --hostname     hostname to listen on                           [string] [default: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  custom domain name for mDNS service (default: sutradhar.local)
                                                                [string] [default: "sutradhar.local"]
      --cors         additional domains to allow for CORS                      [array] [default: []]
      --cwd          working directory [string] [default: "<HOME>"]"
`;

exports[`sutradhar CLI help-text snapshots every documented command emits stable help text: sutradhar mcp --help 1`] = `
"sutradhar mcp

manage MCP (Model Context Protocol) servers

Commands:
  sutradhar mcp add [name]     add an MCP server
  sutradhar mcp list           list MCP servers and their status                        [aliases: ls]
  sutradhar mcp auth [name]    authenticate with an OAuth-enabled MCP server
  sutradhar mcp logout [name]  remove OAuth credentials for an MCP server
  sutradhar mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`sutradhar CLI help-text snapshots every documented command emits stable help text: sutradhar attach --help 1`] = `
"sutradhar attach <url>

attach to a running sutradhar server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --dir           directory to run in                                                   [string]
  -c, --continue      continue the last session                                            [boolean]
  -s, --session       session id to continue                                                [string]
      --fork          fork the session when continuing (use with --continue or --session)  [boolean]
  -p, --password      basic auth password (defaults to SUTRADHAR_SERVER_PASSWORD)            [string]
  -u, --username      basic auth username (defaults to SUTRADHAR_SERVER_USERNAME or 'sutradhar')
                                                                                            [string]
      --mini          start the minimal interactive interface             [boolean] [default: false]
      --no-replay     disable mini session history replay on resume and after resize       [boolean]
      --replay-limit  cap visible mini replay to the newest N messages                      [number]"
`;

exports[`sutradhar CLI help-text snapshots every documented command emits stable help text: sutradhar run --help 1`] = `
"sutradhar run [message..]

run sutradhar with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --command      the command to run, use message for args                               [string]
  -c, --continue     continue the last session                                             [boolean]
  -s, --session      session id to continue                                                 [string]
      --fork         fork the session before continuing (requires --continue or --session) [boolean]
      --share        share the session                                                     [boolean]
  -m, --model        model to use in the format of provider/model                           [string]
      --agent        agent to use                                                           [string]
      --format       format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file         file(s) to attach to message                                            [array]
      --title        title for the session (uses truncated prompt if no value provided)     [string]
      --attach       attach to a running sutradhar server (e.g., http://localhost:4096)      [string]
  -p, --password     basic auth password (defaults to SUTRADHAR_SERVER_PASSWORD)             [string]
  -u, --username     basic auth username (defaults to SUTRADHAR_SERVER_USERNAME or 'sutradhar')
                                                                                            [string]
      --dir          directory to run in, path on remote server if attaching                [string]
      --port         port for the local server (defaults to random port if no value provided)
                                                                                            [number]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [string]
      --thinking     show thinking blocks                                                  [boolean]
  -i, --interactive  run in direct interactive split-footer mode          [boolean] [default: false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                          [boolean] [default: false]"
`;

exports[`sutradhar CLI help-text snapshots every documented command emits stable help text: sutradhar debug --help 1`] = `
"sutradhar debug

debugging and troubleshooting tools

Commands:
  sutradhar debug config        show resolved configuration
  sutradhar debug lsp           LSP debugging utilities
  sutradhar debug rg            ripgrep debugging utilities
  sutradhar debug file          file system debugging utilities
  sutradhar debug scrap         list all known projects
  sutradhar debug skill         list all available skills
  sutradhar debug snapshot      snapshot debugging utilities
  sutradhar debug startup       print startup timing
  sutradhar debug agent <name>  show agent configuration details
  sutradhar debug v2            debug v2 catalog and built-in plugins
  sutradhar debug info          show debug information
  sutradhar debug paths         show global paths (data, config, cache, state)
  sutradhar debug wait          wait indefinitely (for debugging)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
